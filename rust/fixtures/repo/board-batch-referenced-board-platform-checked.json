{
  "derived_from": "spec 045 FR-032 (a board given by a reference is checked against the plan's platform before its write)",
  "env": {},
  "expect_files": {},
  "files": {
    "b.json": "{\"platform\": \"github\", \"steps\": [{\"name\": \"issue\", \"cli\": [\"issue\", \"view\", \"5\", \"--json\", \"url\"]}, {\"name\": \"move\", \"board\": {\"action\": \"set\", \"board\": \"{{issue.url}}\", \"item\": \"#5\", \"state\": \"done\"}}]}"
  },
  "git": [],
  "name": "board-batch-referenced-board-platform-checked",
  "owner": "rust",
  "remote": "git@github.com:o/r.git",
  "routes": [
    {
      "body": {
        "data": {
          "user": {
            "projectV2": {
              "closed": false,
              "field": {
                "dataType": "SINGLE_SELECT",
                "id": "PVTSSF_1",
                "name": "Status",
                "options": [
                  {
                    "id": "OPT_TODO",
                    "name": "To do"
                  },
                  {
                    "id": "OPT_DOING",
                    "name": "In Progress"
                  },
                  {
                    "id": "OPT_REVIEW",
                    "name": "In Review"
                  },
                  {
                    "id": "OPT_DONE",
                    "name": "Done"
                  }
                ]
              },
              "id": "PVT_1",
              "title": "Roadmap",
              "url": "https://github.com/users/me/projects/1"
            }
          }
        }
      },
      "method": "POST",
      "op": "BoardOfUser",
      "path": "/graphql",
      "status": 200,
      "vars": {
        "login": "me",
        "number": 1
      }
    },
    {
      "body": {
        "data": {
          "resource": {
            "__typename": "Issue",
            "id": "I_5",
            "number": 5,
            "projectItems": {
              "nodes": [
                {
                  "fieldValueByName": {
                    "name": "In Progress",
                    "optionId": "x"
                  },
                  "id": "PVTI_5",
                  "project": {
                    "id": "PVT_1"
                  }
                }
              ],
              "pageInfo": {
                "endCursor": null,
                "hasNextPage": false
              }
            },
            "state": "OPEN",
            "title": "Export CSV",
            "url": "https://github.com/o/r/issues/5"
          }
        }
      },
      "method": "POST",
      "op": "ItemOnBoard",
      "path": "/graphql",
      "status": 200,
      "vars": {
        "url": "https://github.com/o/r/issues/5"
      }
    },
    {
      "body": {
        "data": {
          "updateProjectV2ItemFieldValue": {
            "projectV2Item": {
              "id": "PVTI_5"
            }
          }
        }
      },
      "method": "POST",
      "op": "BoardSet",
      "path": "/graphql",
      "status": 200
    }
  ],
  "runs": [
    {
      "argv": [
        "batch",
        "<ROOT>/b.json",
        "--write"
      ],
      "exit": 1,
      "seen": [],
      "stderr_has": [
        "stopped at move"
      ],
      "stdin": null,
      "stdout": "{\n  \"platform\": \"github\",\n  \"ok\": false,\n  \"steps\": [\n    {\n      \"name\": \"issue\",\n      \"ok\": true\n    },\n    {\n      \"name\": \"move\",\n      \"ok\": false,\n      \"error\": \"gitlab:g/p/5 is a gitlab board, the plan is for github\"\n    }\n  ],\n  \"records\": [],\n  \"skipped\": []\n}\n"
    }
  ],
  "store": {
    "ai-gent/github/pat": "tok-3f9a1c77e0\n"
  },
  "stub": true,
  "tools": {
    "gh": {
      "rules": [
        {
          "args": "issue view",
          "stdout": "{\"url\": \"gitlab:g/p/5\"}\n"
        }
      ]
    }
  }
}
