{
  "derived_from": "spec 045 FR-032 (a board step is always a write)",
  "env": {},
  "expect_files": {},
  "files": {
    "b.json": "{\"platform\": \"github\", \"steps\": [{\"name\": \"move\", \"board\": {\"action\": \"set\", \"board\": \"github:me/1\", \"item\": \"https://github.com/o/r/issues/5\", \"state\": \"review\"}}]}",
    "bad.json": "{\"platform\": \"github\", \"steps\": [{\"name\": \"x\", \"board\": {\"action\": \"move\", \"item\": \"https://github.com/o/r/issues/5\"}}]}",
    "other.json": "{\"platform\": \"gitlab\", \"steps\": [{\"name\": \"move\", \"board\": {\"action\": \"set\", \"board\": \"github:me/1\", \"item\": \"https://github.com/o/r/issues/5\", \"state\": \"review\"}}]}"
  },
  "git": [],
  "name": "board-batch-step-needs-write",
  "owner": "rust",
  "remote": "git@github.com:o/r.git",
  "routes": [
    {
      "body": {
        "data": {
          "user": {
            "projectV2": {
              "closed": false,
              "field": {
                "dataType": "SINGLE_SELECT",
                "id": "PVTSSF_1",
                "name": "Status",
                "options": [
                  {
                    "id": "OPT_TODO",
                    "name": "To do"
                  },
                  {
                    "id": "OPT_DOING",
                    "name": "In Progress"
                  },
                  {
                    "id": "OPT_REVIEW",
                    "name": "In Review"
                  },
                  {
                    "id": "OPT_DONE",
                    "name": "Done"
                  }
                ]
              },
              "id": "PVT_1",
              "title": "Roadmap",
              "url": "https://github.com/users/me/projects/1"
            }
          }
        }
      },
      "method": "POST",
      "op": "BoardOfUser",
      "path": "/graphql",
      "status": 200,
      "vars": {
        "login": "me",
        "number": 1
      }
    },
    {
      "body": {
        "data": {
          "resource": {
            "__typename": "Issue",
            "id": "I_5",
            "number": 5,
            "projectItems": {
              "nodes": [
                {
                  "fieldValueByName": {
                    "name": "In Progress",
                    "optionId": "x"
                  },
                  "id": "PVTI_5",
                  "project": {
                    "id": "PVT_1"
                  }
                }
              ],
              "pageInfo": {
                "endCursor": null,
                "hasNextPage": false
              }
            },
            "state": "OPEN",
            "title": "Export CSV",
            "url": "https://github.com/o/r/issues/5"
          }
        }
      },
      "method": "POST",
      "op": "ItemOnBoard",
      "path": "/graphql",
      "status": 200,
      "vars": {
        "url": "https://github.com/o/r/issues/5"
      }
    },
    {
      "body": {
        "data": {
          "updateProjectV2ItemFieldValue": {
            "projectV2Item": {
              "id": "PVTI_5"
            }
          }
        }
      },
      "method": "POST",
      "op": "BoardSet",
      "path": "/graphql",
      "status": 200
    }
  ],
  "runs": [
    {
      "argv": [
        "batch",
        "<ROOT>/b.json"
      ],
      "exit": 3,
      "seen": [],
      "stderr_has": [
        "1 of 1 steps",
        "move [github:me/1]"
      ],
      "stdin": null,
      "stdout": ""
    },
    {
      "argv": [
        "batch",
        "<ROOT>/b.json",
        "--dry-run"
      ],
      "exit": 0,
      "seen": [],
      "stderr_has": [],
      "stdin": null,
      "stdout": "move             write board set github:me/1 https://github.com/o/r/issues/5 review\n"
    },
    {
      "argv": [
        "batch",
        "<ROOT>/bad.json",
        "--dry-run"
      ],
      "exit": 2,
      "seen": [],
      "stderr_has": [
        "action"
      ],
      "stdin": null,
      "stdout": ""
    },
    {
      "argv": [
        "batch",
        "<ROOT>/other.json",
        "--dry-run"
      ],
      "exit": 2,
      "seen": [],
      "stderr_has": [
        "github:me/1",
        "plan is for gitlab"
      ],
      "stdin": null,
      "stdout": ""
    }
  ],
  "store": {
    "ai-gent/github/pat": "tok-3f9a1c77e0\n"
  },
  "stub": true,
  "tools": {}
}
