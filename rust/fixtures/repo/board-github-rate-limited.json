    {
      "body": {
        "data": null,
        "errors": [
          {
            "message": "API rate limit exceeded",
            "type": "RATE_LIMITED"
          }
        ]
      },
      "headers": {
        "X-RateLimit-Reset": "1700000000"
      },
      "method": "POST",
      "op": "BoardsOfUser",
      "path": "/graphql",
      "status": 200,
      "vars": {
        "login": "gql"
      }
    },
    {
      "body": {
        "message": "Bad credentials"
      },
      "method": "POST",
      "op": "BoardsOfUser",
      "path": "/graphql",
      "status": 401,
      "vars": {
        "login": "bad"
      }
    }
  ],
  "runs": [
