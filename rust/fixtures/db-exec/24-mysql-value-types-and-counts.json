{
  "contract_version": 1,
  "name": "mysql-value-types-and-counts",
  "derived_from": "PyMySQL's decoders and dbrun.py to_jsonable() read from their source (not run against PyMySQL here): TIME as str(timedelta), BIT/GEOMETRY/BLOB/BINARY as '<N bytes>', zero and impossible dates left as the server's text, DATETIME as isoformat() with six-digit microseconds, DECIMAL as text; row count of a SELECT is the number of rows returned (PyMySQL buffers), DDL 0, DML the changed rows (no CLIENT_FOUND_ROWS); a CALL reports its first result set only and the connection stays in step; a write in read mode fails at the server with ERROR 1792; items that are code the server would read as more than one statement, or that cannot be classified, are refused before connecting (the port's own rule, D-MY-01)",
  "kind": "exec",
  "engines": [
    "mysql",
    "mariadb"
  ],
  "setup": {
    "mysql": [
      "SET SESSION sql_mode=''",
      "CREATE TABLE v (id INT PRIMARY KEY, t TIME(6), b BIT(8), g GEOMETRY, dt DATETIME(6), d DATE, dec1 DECIMAL(10,2), u BIGINT UNSIGNED, f DOUBLE, y YEAR, bl BLOB, vb VARBINARY(4), txt VARCHAR(10) CHARACTER SET utf8mb4)",
      "INSERT INTO v VALUES (1, '01:02:03.12', b'10101010', ST_GeomFromText('POINT(1 2)'), '2026-11-07 14:59:58.12', '2026-11-07', 1.50, 18446744073709551615, 2.5, 2026, x'0102', 'ab', 'héllo')",
      "INSERT INTO v VALUES (2, '-01:02:03', b'1', ST_GeomFromText('POINT(0 0)'), '0000-00-00 00:00:00', '0000-00-00', -3.10, 0, 1.0, 2000, x'', NULL, '')",
      "INSERT INTO v VALUES (3, '838:59:59', NULL, NULL, '2026-02-00 01:02:03', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)",
      "CREATE TABLE w (id INT PRIMARY KEY, n INT)",
      "INSERT INTO w VALUES (1, 10), (2, 20), (3, 30)",
      "CREATE PROCEDURE two_sets() BEGIN SELECT 1 AS a; SELECT 2 AS b, 3 AS c; END"
    ],
    "mariadb": [
      "SET SESSION sql_mode=''",
      "CREATE TABLE v (id INT PRIMARY KEY, t TIME(6), b BIT(8), g GEOMETRY, dt DATETIME(6), d DATE, dec1 DECIMAL(10,2), u BIGINT UNSIGNED, f DOUBLE, y YEAR, bl BLOB, vb VARBINARY(4), txt VARCHAR(10) CHARACTER SET utf8mb4)",
      "INSERT INTO v VALUES (1, '01:02:03.12', b'10101010', ST_GeomFromText('POINT(1 2)'), '2026-11-07 14:59:58.12', '2026-11-07', 1.50, 18446744073709551615, 2.5, 2026, x'0102', 'ab', 'héllo')",
      "INSERT INTO v VALUES (2, '-01:02:03', b'1', ST_GeomFromText('POINT(0 0)'), '0000-00-00 00:00:00', '0000-00-00', -3.10, 0, 1.0, 2000, x'', NULL, '')",
      "INSERT INTO v VALUES (3, '838:59:59', NULL, NULL, '2026-02-00 01:02:03', NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)",
      "CREATE TABLE w (id INT PRIMARY KEY, n INT)",
      "INSERT INTO w VALUES (1, 10), (2, 20), (3, 30)",
      "CREATE PROCEDURE two_sets() BEGIN SELECT 1 AS a; SELECT 2 AS b, 3 AS c; END"
    ]
  },
