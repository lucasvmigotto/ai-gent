        "committed"
      ]
    },
    {
      "only": "port",
      "difference": "D-004",
      "request": {
        "mode": "read",
        "statements": [
          "SELECT 1"
        ],
        "timeout": 5,
        "max_rows": 1000001
      },
      "expected": {
        "ok": false,
        "stage": "connect",
        "error_contains": "invalid max_rows"
      },
      "absent": [
        "results",
        "seconds"
      ]
    },
    {
      "request": {
        "mode": "read",
        "statements": [
          "SELECT COUNT(*) FROM t"
        ],
        "timeout": 5,
        "max_rows": 200
      },
      "expected": {
        "ok": true,
        "results": [
          {
            "rows": [
