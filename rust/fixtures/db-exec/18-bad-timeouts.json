        "committed"
      ]
    },
    {
      "only": "port",
      "difference": "D-004",
      "request": {
        "mode": "write",
        "statements": [
          "DELETE FROM t"
        ],
        "timeout": true,
        "max_rows": 200
      },
      "expected": {
        "ok": false,
        "stage": "connect",
        "error_contains": "invalid timeout"
      },
      "absent": [
        "results",
        "seconds",
        "committed"
      ]
    },
    {
      "only": "port",
      "difference": "D-004",
      "request": {
        "mode": "write",
        "statements": [
          "DELETE FROM t"
        ],
        "timeout": [
          5
        ],
        "max_rows": 200
      },
      "expected": {
        "ok": false,
        "stage": "connect",
        "error_contains": "invalid timeout"
      },
      "absent": [
        "results",
        "seconds",
        "committed"
