{
  "contract_version": 1,
  "name": "read-failure-keeps-results",
  "derived_from": "plugins/db/scripts/dbrun.py execute(): a statement that fails keeps the results of the ones before it, reports stage execute with seconds, and later statements do not run",
  "kind": "exec",
  "engines": [
    "sqlite"
  ],
  "setup": {
    "sqlite": [
      "CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER NOT NULL)",
      "INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)"
    ]
  },
  "steps": [
    {
      "request": {
        "mode": "read",
        "statements": [
          "SELECT 1",
          "SELECT * FROM nope_table",
          "SELECT 2"
        ],
        "timeout": 5,
        "max_rows": 200
      },
      "expected": {
        "ok": false,
        "stage": "execute",
        "error_contains": "nope_table",
        "seconds": "$number",
        "results": [
          {
            "rowcount": -1,
            "rows": [
              [
                1
              ]
            ]
          }
        ]
      },
      "absent": [
        "committed"
      ]
    }
  ]
}
