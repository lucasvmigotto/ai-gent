{
  "name": "rollback-on-count-mismatch",
  "derived_from": "plugins/db/scripts/test_dbrun.py SqliteEndToEndTest.test_apply_rolls_back_on_count_mismatch",
  "kind": "exec",
  "engines": ["sqlite"],
  "setup": {
    "sqlite": [
      "CREATE TABLE customer (id INTEGER PRIMARY KEY, nome TEXT, email TEXT, status TEXT)",
      "INSERT INTO customer VALUES (1, 'Ana Lima', 'ana@example.com', 'active'), (2, 'Bruno Reis', 'bruno@example.com', 'blocked'), (3, 'Caio Dias', 'caio@example.com', 'active')"
    ]
  },
  "steps": [
    {
      "request": {"mode": "write", "statements": ["DELETE FROM customer WHERE status = 'active'"], "expect": [5], "timeout": 5, "max_rows": 200},
      "expected": {
        "ok": false,
        "stage": "verify",
        "error_contains": "row counts differ from the plan: statement 1: expected 5, got 2",
        "results": [{"rowcount": 2}]
      }
    },
    {
      "request": {"mode": "read", "statements": ["SELECT COUNT(*) FROM customer"], "timeout": 5, "max_rows": 10},
      "expected": {"ok": true, "results": [{"rows": [[3]]}]}
    },
    {
      "request": {"mode": "write", "statements": ["DELETE FROM customer WHERE id = 3", "DELETE FROM customer WHERE id = 99"], "expect": [null, 1], "timeout": 5, "max_rows": 200},
      "expected": {"ok": false, "stage": "verify", "error_contains": "statement 2: expected 1, got 0"}
    },
    {
      "request": {"mode": "read", "statements": ["SELECT COUNT(*) FROM customer"], "timeout": 5, "max_rows": 10},
      "expected": {"ok": true, "results": [{"rows": [[3]]}]}
    }
  ]
}
