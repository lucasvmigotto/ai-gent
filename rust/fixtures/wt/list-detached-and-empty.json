    "list"
   ],
   "cwd": ".",
   "expect": {
    "code": 0,
    "stdout": "no worktrees under .worktrees/\n",
    "stderr": ""
   }
  },
  {
   "git": [
    "worktree",
    "add",
    "-q",
    "--detach",
    ".worktrees/det",
    "dev"
   ],
   "cwd": "."
  },
  {
   "wt": [
    "list"
   ],
   "cwd": ".",
   "expect": {
    "code": 0,
    "stdout": "(detached)                           .worktrees/det                               +None/-None vs dev\n",
    "stderr": ""
   }
  },
  {
   "wt": [
    "list",
    "--json"
   ],
   "cwd": ".",
   "expect": {
    "code": 0,
    "stdout": "[\n  {\n    \"branch\": \"(detached)\",\n    \"path\": \".worktrees/det\",\n    \"dirty\": false,\n    \"ahead\": null,\n    \"behind\": null\n  }\n]\n",
    "stderr": ""
   }
  },
  {
   "wt": [
    "remove",
    "(detached)"
   ],
   "cwd": ".",
   "expect": {
    "code": 1,
    "stdout": "",
    "stderr": "error: no worktree under .worktrees/ for (detached)\n"
   }
  }
 ],
