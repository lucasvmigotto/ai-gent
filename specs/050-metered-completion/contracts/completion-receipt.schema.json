{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "task": {
      "type": "object",
      "properties": {
        "repository_id": {
          "type": "string",
          "format": "uuid"
        },
        "feature_id": {
          "type": "string",
          "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^T[0-9]{3,}$"
        }
      },
      "required": [
        "repository_id",
        "feature_id",
        "task_id"
      ],
      "additionalProperties": false
    },
    "task_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "accepted",
        "exempt"
      ]
    },
    "ledger_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_receipt_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registered_run_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "enum": [
              "planner",
              "coordinator",
              "builder",
              "reviewer",
              "repair",
              "verification",
              "recovery"
            ]
          },
          "closure_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "evidence_digests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 100000
          },
          "outcome": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "counters": {
            "type": "object",
            "properties": {
              "input_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cached_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cache_creation_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "output_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasoning_output": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "input_total",
              "cached_input",
              "cache_creation_input",
              "output_total",
              "reasoning_output"
            ],
            "additionalProperties": false
          },
          "quality": {
            "enum": [
              "complete",
              "partial",
              "imported",
              "missing"
            ]
          },
          "attribution": {
            "enum": [
              "exclusive",
              "shared",
              "unattributed"
            ]
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100000,
            "items": {
              "type": "object",
              "properties": {
                "segment_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "identity": {
                  "type": "object",
                  "properties": {
                    "agent_app": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "agent_version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "requested_provider": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "requested_model": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effective_provider": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effective_model": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effort": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "identity_quality": {
                      "enum": [
                        "verified",
                        "reported",
                        "unknown"
                      ]
                    },
                    "config_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "model_vendor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "service_tier": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "provider_region": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "agent_app",
                    "agent_version",
                    "requested_provider",
                    "requested_model",
                    "effective_provider",
                    "effective_model",
                    "effort",
                    "identity_quality",
                    "config_digest",
                    "model_vendor",
                    "service_tier",
                    "provider_region"
                  ],
                  "additionalProperties": false
                },
                "counters": {
                  "type": "object",
                  "properties": {
                    "input_total": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cached_input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cache_creation_input": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "output_total": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "reasoning_output": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "input_total",
                    "cached_input",
                    "cache_creation_input",
                    "output_total",
                    "reasoning_output"
                  ],
                  "additionalProperties": false
                },
                "evidence_digests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "minItems": 1,
                  "maxItems": 100000
                }
              },
              "required": [
                "segment_id",
                "identity",
                "counters",
                "evidence_digests"
              ],
              "additionalProperties": false
            }
          },
          "started_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "ended_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "host_session_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "run_id",
          "role",
          "closure_digest",
          "evidence_digests",
          "outcome",
          "counters",
          "quality",
          "attribution",
          "attempt_id",
          "segments",
          "started_at",
          "ended_at",
          "elapsed_ms",
          "host_session_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "review_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "check_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "quality": {
      "enum": [
        "complete",
        "partial",
        "imported",
        "missing"
      ]
    },
    "attribution": {
      "enum": [
        "exclusive",
        "shared",
        "unattributed"
      ]
    },
    "attestation": {
      "enum": [
        "local",
        "provider_reconciled"
      ]
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "exclusive_totals": {
      "type": "object",
      "properties": {
        "input_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_creation_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input_total",
        "cached_input",
        "cache_creation_input",
        "output_total",
        "reasoning_output"
      ],
      "additionalProperties": false
    },
    "shared_scope_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "exemption_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "task",
    "task_fingerprint",
    "attempt_id",
    "attempt_generation",
    "policy_digest",
    "artifact_digest",
    "outcome",
    "ledger_sequence",
    "previous_receipt_digest",
    "registered_run_manifest_digest",
    "runs",
    "review_digests",
    "check_digests",
    "quality",
    "attribution",
    "attestation",
    "normalization_version",
    "exclusive_totals",
    "shared_scope_digests",
    "exemption_digest",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-gent.invalid/contracts/completion-receipt-v1.schema.json",
  "title": "Proposed completion receipt v1"
}
