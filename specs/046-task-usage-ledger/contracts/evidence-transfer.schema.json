{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized portable usage evidence bundle v1",
  "description": "Structural format. Runtime validation additionally checks byte bounds, graph/scope consistency, pseudonym vocabulary, arithmetic, identities and contribution overlap. Imported archives never affect local measured totals.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "usage_evidence_bundle"
    },
    "repository_id": {
      "type": "string",
      "format": "uuid"
    },
    "quality": {
      "const": "imported"
    },
    "assurance": {
      "const": "local_unverified"
    },
    "coverage": {
      "const": "unclosed"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "repository_id": {
                "type": "string",
                "format": "uuid"
              },
              "feature_id": {
                "type": "string",
                "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 128
              },
              "task_id": {
                "type": "string",
                "pattern": "^T[0-9]{3,}$",
                "maxLength": 32
              }
            },
            "required": [
              "repository_id",
              "feature_id",
              "task_id"
            ],
            "additionalProperties": false
          },
          "execution_scope": {
            "type": "object",
            "required": [
              "kind",
              "beneficiaries"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "exclusive",
                  "shared",
                  "unattributed"
                ]
              },
              "beneficiaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "repository_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "feature_id": {
                      "type": "string",
                      "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "task_id": {
                      "type": "string",
                      "pattern": "^T[0-9]{3,}$"
                    }
                  },
                  "required": [
                    "repository_id",
                    "feature_id",
                    "task_id"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100000
              }
            },
            "additionalProperties": false
          },
          "host_session_id": {
            "type": "null"
          },
          "task_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "parent_attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "phase": {
            "enum": [
              "planner",
              "coordinator",
              "builder",
              "reviewer",
              "repair",
              "verification",
              "recovery"
            ]
          },
          "role": {
            "enum": [
              "planner",
              "coordinator",
              "builder",
              "reviewer",
              "reader"
            ]
          },
          "purpose": {
            "enum": [
              "implementation",
              "retry",
              "review",
              "repair",
              "planning",
              "coordination",
              "verification",
              "recovery"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "state": {
            "enum": [
              "registered",
              "running",
              "finished",
              "failed",
              "cancelled"
            ]
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": {
              "type": "object",
              "properties": {
                "segment_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "configuration": {
                  "type": "object",
                  "properties": {
                    "agent_app": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "agent_version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "requested_provider": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "requested_model": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effective_provider": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effective_model": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "effort": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "config_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "model_vendor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "service_tier": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    },
                    "provider_region": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "agent_app",
                    "agent_version",
                    "requested_provider",
                    "requested_model",
                    "effective_provider",
                    "effective_model",
                    "effort",
                    "config_digest",
                    "model_vendor",
                    "service_tier",
                    "provider_region"
                  ],
                  "additionalProperties": false
                },
                "identity_quality": {
                  "enum": [
                    "reported",
                    "unknown"
                  ]
                }
              },
              "required": [
                "segment_id",
                "configuration",
                "identity_quality"
              ],
              "additionalProperties": false
            }
          },
          "usage_quality": {
            "const": "missing"
          }
        },
        "required": [
          "task",
          "execution_scope",
          "host_session_id",
          "task_fingerprint",
          "attempt_id",
          "attempt_ordinal",
          "parent_attempt_id",
          "run_id",
          "parent_run_id",
          "phase",
          "role",
          "purpose",
          "generation",
          "state",
          "segments",
          "usage_quality"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "task": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "repository_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "feature_id": {
                    "type": "string",
                    "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "task_id": {
                    "type": "string",
                    "pattern": "^T[0-9]{3,}$"
                  }
                },
                "required": [
                  "repository_id",
                  "feature_id",
                  "task_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_run_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "phase": {
            "enum": [
              "planner",
              "coordinator",
              "builder",
              "reviewer",
              "repair",
              "verification",
              "recovery"
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "identity": {
            "type": "object",
            "properties": {
              "agent_app": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "agent_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "requested_provider": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "requested_model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "effective_provider": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "effective_model": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "effort": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "identity_quality": {
                "enum": [
                  "reported",
                  "unknown"
                ]
              },
              "config_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "model_vendor": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "service_tier": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "provider_region": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              }
            },
            "required": [
              "agent_app",
              "agent_version",
              "requested_provider",
              "requested_model",
              "effective_provider",
              "effective_model",
              "effort",
              "identity_quality",
              "config_digest",
              "model_vendor",
              "service_tier",
              "provider_region"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "adapter": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "adapter_version": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "request_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "scope": {
                "enum": [
                  "request_delta",
                  "turn_total",
                  "session_cumulative"
                ]
              },
              "semantics": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "reference": {
                "type": "string",
                "pattern": "^evidence:sha256/[0-9a-f]{64}$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "adapter",
              "adapter_version",
              "namespace",
              "request_id",
              "event_id",
              "scope",
              "semantics",
              "reference",
              "digest"
            ],
            "additionalProperties": false
          },
          "raw_usage": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "counters": {
            "type": "object",
            "properties": {
              "input_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cached_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cache_creation_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "output_total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasoning_output": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "input_total",
              "cached_input",
              "cache_creation_input",
              "output_total",
              "reasoning_output"
            ],
            "additionalProperties": false
          },
          "quality": {
            "enum": [
              "complete",
              "partial",
              "imported",
              "missing"
            ]
          },
          "attribution": {
            "enum": [
              "exclusive",
              "shared",
              "unattributed"
            ]
          },
          "attestation": {
            "const": "local"
          },
          "contribution": {
            "enum": [
              "authoritative",
              "observation"
            ]
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 0,
            "maxItems": 0
          },
          "extensions": {
            "type": "object",
            "maxProperties": 0
          },
          "execution_scope": {
            "type": "object",
            "required": [
              "kind",
              "beneficiaries"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "exclusive",
                  "shared",
                  "unattributed"
                ]
              },
              "beneficiaries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "repository_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "feature_id": {
                      "type": "string",
                      "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "task_id": {
                      "type": "string",
                      "pattern": "^T[0-9]{3,}$"
                    }
                  },
                  "required": [
                    "repository_id",
                    "feature_id",
                    "task_id"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100000
              }
            },
            "additionalProperties": false
          },
          "observed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "host_session_id": {
            "type": "null"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "task",
          "attempt_id",
          "run_id",
          "parent_run_id",
          "segment_id",
          "phase",
          "sequence",
          "identity",
          "source",
          "raw_usage",
          "counters",
          "quality",
          "attribution",
          "attestation",
          "contribution",
          "supersedes",
          "extensions",
          "execution_scope",
          "observed_at",
          "occurred_at",
          "host_session_id"
        ],
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://ai-gent.invalid/contracts/usage-observation-v1.schema.json",
        "title": "Proposed usage observation v1"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repository_id",
    "quality",
    "assurance",
    "coverage",
    "runs",
    "observations"
  ],
  "additionalProperties": false
}
