{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "task": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "repository_id": {
              "type": "string",
              "format": "uuid"
            },
            "feature_id": {
              "type": "string",
              "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "task_id": {
              "type": "string",
              "pattern": "^T[0-9]{3,}$"
            }
          },
          "required": [
            "repository_id",
            "feature_id",
            "task_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "segment_id": {
      "type": "string",
      "format": "uuid"
    },
    "phase": {
      "enum": [
        "planner",
        "coordinator",
        "builder",
        "reviewer",
        "repair",
        "verification",
        "recovery"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identity": {
      "type": "object",
      "properties": {
        "agent_app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "requested_provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "effective_provider": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "effective_model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "effort": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "identity_quality": {
          "enum": [
            "verified",
            "reported",
            "unknown"
          ]
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model_vendor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "service_tier": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "provider_region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "agent_app",
        "agent_version",
        "requested_provider",
        "requested_model",
        "effective_provider",
        "effective_model",
        "effort",
        "identity_quality",
        "config_digest",
        "model_vendor",
        "service_tier",
        "provider_region"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "scope": {
          "enum": [
            "request_delta",
            "turn_total",
            "session_cumulative"
          ]
        },
        "semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "reference": {
          "type": "string",
          "pattern": "^evidence:[a-zA-Z0-9/_:.=-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "adapter",
        "adapter_version",
        "namespace",
        "request_id",
        "event_id",
        "scope",
        "semantics",
        "reference",
        "digest"
      ],
      "additionalProperties": false
    },
    "raw_usage": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "counters": {
      "type": "object",
      "properties": {
        "input_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cache_creation_input": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoning_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input_total",
        "cached_input",
        "cache_creation_input",
        "output_total",
        "reasoning_output"
      ],
      "additionalProperties": false
    },
    "quality": {
      "enum": [
        "complete",
        "partial",
        "imported",
        "missing"
      ]
    },
    "attribution": {
      "enum": [
        "exclusive",
        "shared",
        "unattributed"
      ]
    },
    "attestation": {
      "enum": [
        "local",
        "provider_reconciled"
      ]
    },
    "contribution": {
      "enum": [
        "authoritative",
        "observation",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 0,
      "maxItems": 100000
    },
    "extensions": {
      "type": "object"
    },
    "execution_scope": {
      "type": "object",
      "required": [
        "kind",
        "beneficiaries"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exclusive",
            "shared",
            "unattributed"
          ]
        },
        "beneficiaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository_id": {
                "type": "string",
                "format": "uuid"
              },
              "feature_id": {
                "type": "string",
                "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "task_id": {
                "type": "string",
                "pattern": "^T[0-9]{3,}$"
              }
            },
            "required": [
              "repository_id",
              "feature_id",
              "task_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "task",
    "attempt_id",
    "run_id",
    "parent_run_id",
    "segment_id",
    "phase",
    "sequence",
    "identity",
    "source",
    "raw_usage",
    "counters",
    "quality",
    "attribution",
    "attestation",
    "contribution",
    "supersedes",
    "extensions",
    "execution_scope",
    "observed_at",
    "occurred_at",
    "host_session_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-gent.invalid/contracts/usage-observation-v1.schema.json",
  "title": "Proposed usage observation v1"
}
