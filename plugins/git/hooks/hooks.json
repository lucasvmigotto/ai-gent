{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/../../scripts/update-check.sh\"; if [ -f \"$f\" ]; then exec bash \"$f\"; fi; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
