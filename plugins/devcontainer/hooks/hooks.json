{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"; [ -f \"$f\" ] || exit 0; exec sh \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.tsx"
  ]
}
