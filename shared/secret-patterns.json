{
  "comment": "Value patterns for credentials pasted into a conversation. Read by plugins/project/scripts/sessions.py (project:recap redacts transcripts with them) and by the secrets plugin's Claude Code mod (it masks what the person sends). Python re and JavaScript RegExp must read each source the same way: no inline flags (the flags field), no lookbehind, replacements use \\1 style groups. The order is the order they are applied in. skipIn lists the places a pattern is left out of: skill bodies are written text, so only the high-confidence kinds are applied there.",
  "patterns": [
    {
      "kind": "private-key",
      "source": "-----BEGIN [A-Z ]*PRIVATE KEY-----.*?-----END [A-Z ]*PRIVATE KEY-----",
      "flags": "s",
      "replacement": "<private key>"
    },
    {
      "kind": "assignment",
      "source": "\\b([A-Z0-9_]*(?:PASSWORD|PASSWD|PWD|SECRET|TOKEN|API_?KEY|ACCESS_?KEY|PAT))\\b(\\s*[=:]\\s*)(\"[^\"]*\"|'[^']*'|\\S+)",
      "flags": "i",
      "replacement": "\\1\\2<redacted>",
      "toggle": "maskAssignments",
      "skipIn": ["skill"]
    },
    {
      "kind": "auth-header",
      "source": "\\b(bearer|basic)\\s+[A-Za-z0-9._~+/=-]{12,}",
      "flags": "i",
      "replacement": "\\1 <redacted>",
      "skipIn": ["skill"]
    },
    {
      "kind": "github-token",
      "source": "\\b(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})",
      "flags": "",
      "replacement": "<token>",
      "entry": "ai-gent/github/pat"
    },
    {
      "kind": "api-key",
      "source": "\\b(sk-[A-Za-z0-9_-]{20,})",
      "flags": "",
      "replacement": "<token>"
    },
    {
      "kind": "aws-key",
      "source": "\\b(AKIA[0-9A-Z]{16})",
      "flags": "",
      "replacement": "<token>"
    },
    {
      "kind": "slack-token",
      "source": "\\b(xox[baprs]-[A-Za-z0-9-]{10,})",
      "flags": "",
      "replacement": "<token>"
    },
    {
      "kind": "url-credentials",
      "source": "\\b([a-z][a-z0-9+.-]*://[^:/@\\s]+):[^@\\s]+@",
      "flags": "i",
      "replacement": "\\1:<redacted>@"
    }
  ]
}
