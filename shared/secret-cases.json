{
  "comment": "Cases for the credential patterns in secret-patterns.json, run by plugins/project/scripts/test_scripts.py (Python) and plugins/secrets/hooks/secret-mask.test.ts (the Claude Code mod), which must give the same output. Credential shapes are assembled from vars at test time, so no full token shape is committed here. Each var is parts joined, then fill repeated times. skill: true cases run the way a skill body is masked, with only the high-confidence kinds.",
  "vars": {
    "GHP": { "parts": ["gh", "p_"], "fill": "A", "times": 36 },
    "GHPAT": { "parts": ["github", "_pat_"], "fill": "B", "times": 30 },
    "SK": { "parts": ["sk", "-"], "fill": "C", "times": 24 },
    "AKIA": { "parts": ["AK", "IA"], "fill": "7", "times": 16 },
    "XOX": { "parts": ["xo", "xb-"], "fill": "9", "times": 12 },
    "JWT": { "parts": ["eyJhbGci", "OiJIUzI1NiIs"], "fill": "", "times": 0 },
    "PW": { "parts": ["hunt", "er22"], "fill": "", "times": 0 },
    "PKEY": { "parts": ["-----BEGIN OPENSSH PRIV", "ATE KEY-----\nb3BlbnNzaC1rZXk\n-----END OPENSSH PRIV", "ATE KEY-----"], "fill": "", "times": 0 }
  },
  "cases": [
    { "name": "github token", "input": "here is my token {GHP} please use it", "expected": "here is my token <token> please use it", "kinds": { "github-token": 1 } },
    { "name": "github fine-grained token", "input": "{GHPAT}", "expected": "<token>", "kinds": { "github-token": 1 } },
    { "name": "assignment in a command", "input": "DB_PASSWORD={PW} npm test", "expected": "DB_PASSWORD=<redacted> npm test", "kinds": { "assignment": 1 } },
    { "name": "quoted assignment", "input": "export API_KEY='x y z'", "expected": "export API_KEY=<redacted>", "kinds": { "assignment": 1 } },
    { "name": "colon assignment", "input": "password: {PW}", "expected": "password: <redacted>", "kinds": { "assignment": 1 } },
    { "name": "private key block", "input": "key:\n{PKEY}\nend", "expected": "key:\n<private key>\nend", "kinds": { "private-key": 1 } },
    { "name": "bearer header", "input": "Authorization: Bearer {JWT}", "expected": "Authorization: Bearer <redacted>", "kinds": { "auth-header": 1 } },
    { "name": "basic header keeps its case", "input": "authorization: basic {JWT}", "expected": "authorization: basic <redacted>", "kinds": { "auth-header": 1 } },
    { "name": "api key", "input": "use {SK} for it", "expected": "use <token> for it", "kinds": { "api-key": 1 } },
    { "name": "aws key", "input": "{AKIA}", "expected": "<token>", "kinds": { "aws-key": 1 } },
    { "name": "slack token", "input": "{XOX}", "expected": "<token>", "kinds": { "slack-token": 1 } },
    { "name": "credentials in a url", "input": "postgres://app:{PW}@db:5432/x", "expected": "postgres://app:<redacted>@db:5432/x", "kinds": { "url-credentials": 1 } },
    { "name": "two kinds at once", "input": "{GHP} and DB_PASSWORD={PW}", "expected": "<token> and DB_PASSWORD=<redacted>", "kinds": { "assignment": 1, "github-token": 1 } },
    { "name": "nothing to mask", "input": "run the tests and show me the diff", "expected": "run the tests and show me the diff", "kinds": {} },
    { "name": "a url without credentials", "input": "see https://example.com/a:b/c", "expected": "see https://example.com/a:b/c", "kinds": {} },
    { "name": "skill body keeps prose and examples", "skill": true, "input": "Basic authentication needs DB_PASSWORD=<value> set", "expected": "Basic authentication needs DB_PASSWORD=<value> set", "kinds": {} },
    { "name": "skill body still loses a token", "skill": true, "input": "token {GHP} here", "expected": "token <token> here", "kinds": { "github-token": 1 } }
  ]
}
