{
	"name": "ai-gent-docs",
	"private": true,
	"version": "1.6.0",
	"type": "module",
	"scripts": {
		"gen": "node scripts/generate-content.mjs",
		"og": "bun run scripts/og-image.ts",
		"dev": "bun run gen && vite",
		"build": "bun run gen && vite build && bun scripts/generate-llms.ts",
		"preview": "vite preview",
		"lint": "biome check .",
		"typecheck": "bun run gen && tsc --noEmit",
		"test": "bun run gen && vitest run",
		"test:watch": "vitest",
		"e2e": "bun tests/e2e/smoke.mjs"
	},
	"dependencies": {
		"lucide-react": "1.64.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"react-router": "8.5.1",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"happy-dom": "21.0.4",
		"jest-axe": "11.0.0",
		"selenium-webdriver": "4.51.0",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
