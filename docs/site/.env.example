# Origin of the deployed docs site, used for canonical and Open Graph URLs.
# CI overrides this with VITE_SITE_URL, derived from the repository name.
VITE_SITE_URL=https://docs.lucasvmigotto.me/ai-gent
# Build base path. CI overrides this with VITE_BASE_PATH (also derived from
# the repository name), so the built site lives under the hub prefix /ai-gent/.
VITE_BASE_PATH=/ai-gent/
